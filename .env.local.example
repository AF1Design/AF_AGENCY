# إعدادات الربط بقاعدة بيانات سوبابيس (Supabase)
# يمكنك الحصول عليها من: لوحة تحكم مشروعك -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# رقم الواتساب الرسمي لمنصة AF AGENCY (مع كود الدولة وبدون علامة الزائد، مثال: 201012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# اسم المنصة
NEXT_PUBLIC_AGENCY_NAME=AF AGENCY
